#
# Refuses to commit operational data to a public repository.
#
# This exists because the class of mistake keeps recurring under a new file
# name. Real Oregon Food Bank exports were committed once and had to be scrubbed
# from history with git filter-repo and a GitHub Support request — history is
# public the moment it is pushed, and a scrub does not un-disclose anything.
#
# `.gitignore` closes one filename at a time and is always one format behind:
# `*.db` shipped in the first commit but did not match `dev.db-wal`, which went
# unignored for three months (2026-05-19 to 2026-08-14). A write-ahead log holds
# committed page data not yet checkpointed, so a WAL captured after a Link2Feed
# import contains real client rows. Nothing landed in that window, by luck.
#
# So this checks what a file *is*, not what it is called.
#
# Install:  git config core.hooksPath .githooks
# Override: FEED_ALLOW_LARGE=1 git commit …   (large legitimate assets only)

set -eu

RED=$(printf '\033[0;31m'); YEL=$(printf '\033[1;33m'); NC=$(printf '\033[0m')
fail=0
MAX_BYTES=${FEED_MAX_BLOB_BYTES:-5242880}   # 5 MB

# Only added/copied/modified/renamed paths; deletions cannot leak anything.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

reject() {
  fail=1
  printf '%s  BLOCKED%s  %s\n' "$RED" "$NC" "$1"
  printf '           %s\n' "$2"
}

for path in $staged; do
  # Read the staged content, not the working tree — they can differ.
  blob=":$path"
  size=$(git cat-file -s "$(git rev-parse ":$path" 2>/dev/null)" 2>/dev/null || echo 0)

  # 1. Size. Operational data is almost always large; source almost never is.
  if [ "$size" -gt "$MAX_BYTES" ] && [ "${FEED_ALLOW_LARGE:-0}" != "1" ]; then
    reject "$path" "$(printf '%s bytes exceeds the %s byte limit. If this is a legitimate asset: FEED_ALLOW_LARGE=1 git commit' "$size" "$MAX_BYTES")"
    continue
  fi

  # 2. File type by magic number, so a renamed database is caught too.
  head8=$(git show "$blob" 2>/dev/null | head -c 8 | xxd -p 2>/dev/null | tr -d '\n' || true)
  case "$head8" in
    53514c69746520*)   reject "$path" "SQLite database (magic 'SQLite format 3'). Databases never belong in the repository." ;;
    377f0682*|377f0683*) reject "$path" "SQLite write-ahead log. A WAL holds real client rows not yet checkpointed." ;;
    d9d505f920a163d7*) reject "$path" "SQLite rollback journal. Same exposure as the database it belongs to." ;;
  esac

  # 3. Names that are always operational data, whatever they contain.
  case "$path" in
    *feed-backup-*.json|*feed-backup-*.JSON)
      reject "$path" "FEED backup artifact — every client record the system holds." ;;
    *.db|*.db-wal|*.db-shm|*.db-journal|*.sqlite|*.sqlite3)
      reject "$path" "Database file. Should already be ignored; something forced it." ;;
  esac

  # 4. Client PII columns in a data file.
  #
  # Exempts reviewed test fixtures: link2feed-visits-with-extra-columns.csv
  # carries `Client First Name` and `Email Address` headers deliberately, to
  # prove the adapter ignores them. That exemption is the thing to watch — a
  # real export dropped into a fixtures directory would pass. Fixtures are small
  # and read in review; keep them synthetic and obviously so.
  case "$path" in
    */test/fixtures/*|*/__tests__/*|*/fixtures/*) ;;
    *.csv|*.CSV|*.json|*.xlsx|*.xls|*.tsv)
      if git show "$blob" 2>/dev/null | head -c 65536 | LC_ALL=C grep -qaE \
        'Client First Name|Client Last Name|Client Email Addresses|Client Phone Numbers|Neighbor Date of Birth|Visit Recorded By'; then
        reject "$path" "Contains client PII column headers. Real exports belong outside the repository (FEED_PRIVATE_DATA_DIR)."
      fi ;;
  esac
done

if [ "$fail" -ne 0 ]; then
  printf '\n%sCommit refused.%s Operational data must not enter a public repository.\n' "$RED" "$NC"
  printf 'Real exports and backups live outside the repo — see FEED_PRIVATE_DATA_DIR in AGENTS.md.\n'
  printf 'To unstage a file:  git restore --staged <path>\n\n'
  printf '%sIf a file already reached a push, removing it now is not enough%s — history is\n' "$YEL" "$NC"
  printf 'public once pushed. See AGENTS.md for the filter-repo and GitHub Support path.\n\n'
  exit 1
fi

exit 0
